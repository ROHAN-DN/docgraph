# Neo4j connection used by the application and local Compose stack.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=docgraph-local-password
NEO4J_DATABASE=neo4j

# Provider settings are consumed by later pipeline phases.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional pricing rates used for transparent estimates (USD per million tokens).
# Leave unset to report token counts without estimating cost.
EXTRACTION_INPUT_USD_PER_MILLION_TOKENS=
EXTRACTION_OUTPUT_USD_PER_MILLION_TOKENS=

# Entity resolution embeddings (currently OpenAI embeddings).
EMBEDDING_MODEL=text-embedding-3-small
ENTITY_RESOLUTION_THRESHOLD=0.86
LINEAGE_SUGGESTION_THRESHOLD=0.50
FEEDBACK_DATABASE_PATH=.docgraph/feedback.sqlite3
